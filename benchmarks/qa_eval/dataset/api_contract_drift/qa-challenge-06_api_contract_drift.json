  },
  "expected_resolution": {
    "healed_assertion": "assert str(response.data.invoice_id) == '10423'",
    "strategy": "TYPE_COERCION_ASSERTION"
  },
  "benchmark_targets": {
    "max_heal_time_sec": 2.0,
    "max_token_cost": 280,
    "min_confidence_score": 0.9
  }
